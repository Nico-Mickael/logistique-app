# ============================================================
# Logistique ADES — Variables d'environnement (frontend)
# Copiez ce fichier en `.env.local` pour des valeurs locales
# de développement. Les variables VITE_* sont embarquées au build.
# ============================================================

# URL de base de l'API backend.
#  - Déploiement "serveur unique" (recommandé) : laisser /api (même origine)
#  - Frontend/backend séparés : http://mabackend:5000/api
VITE_API_BASE_URL=/api
