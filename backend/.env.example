# ============================================================
# Logistique ADES — Variables d'environnement (backend)
# Copiez ce fichier en `.env` et renseignez les valeurs.
# Ne commitez JAMAIS le fichier `.env`.
# ============================================================

# --- Base de données PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=logistique
DB_PASSWORD=logistique123
DB_NAME=logistique_db

# --- Serveur / sécurité ---
# Secret obligatoire pour signer les JWT (changez-le en production !)
JWT_SECRET=changezmoi_une_longue_chainee_aleatoire
PORT=5000
# Origines autorisées par CORS ('*' = toutes). Ex: https://app.mondomaine.com
CORS_ORIGIN=*

# --- Email (optionnel : si non renseigné, l'email est désactivé) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# --- Notifications push téléphone (Web Push / VAPID) ---
# Obligatoire pour activer les notifications push. Génération :
#   npx web-push generate-vapid-keys
# Puis copiez les deux clés ci-dessous (lignes Public/Private Key).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact affiché par les navigateurs (mailto: ou https://). Recommandé.
VAPID_SUBJECT=mailto:logistique@ades.mg
# Forcer l'activation/désactivation même si les clés sont présentes.
# true = activé (défaut auto si les clés sont renseignées).
# false = force la désactivation.
PUSH_ENABLED=

# --- Frontend (déploiement "serveur unique") ---
# Chemin du build statique du frontend (défaut: ../frontend/dist)
FRONTEND_DIST=
# Mettre à 'false' pour désactiver le serveur de fichiers statiques frontend
SERVE_FRONTEND=true

# --- Mode ---
# development | test | production
NODE_ENV=development
